<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the app be built from macOS/Linux too (e.g. CI or a dev sandbox). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WPF0001: the Fluent theme API (ThemeMode) is marked experimental.
         WFO0003: WinForms analyzer wants DPI set in code, but this is a WPF app (WinForms is only
         used for the tray icon), so per-monitor DPI awareness must stay in app.manifest. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>

    <AssemblyName>FreeFlow</AssemblyName>
    <RootNamespace>FreeFlow.Windows</RootNamespace>
    <ApplicationIcon>Assets\FreeFlow.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>FreeFlow</Product>
    <Description>Free and fast voice dictation for Windows</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Single, self-contained FreeFlow.exe: nothing else to install. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\FreeFlow.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

</Project>
